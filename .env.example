# Copy to .env to override. Every value here is a local-development default;
# docker-compose.yml falls back to the same values when .env is absent.
POSTGRES_USER=qauym
POSTGRES_PASSWORD=qauym
POSTGRES_DB=qauym

# local | production. Outside "local" the session cookie is marked Secure.
APP_ENV=local

# Git commit recorded on analytics runs and benchmark output.
GIT_SHA=dev

API_PORT=8000
WEB_PORT=5173
