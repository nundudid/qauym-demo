  "info": {
    "title": "Qauym API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/analytics/runs": {
      "get": {
        "operationId": "list_runs_api_v1_admin_analytics_runs_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Runs",
        "tags": [
          "admin"
        ]
      },
      "post": {
        "description": "Build a snapshot, run Leiden and Louvain, validate, and publish Leiden.\n\nSynchronous in M1. If a run is already in progress, or one already exists for\nthis minute, nothing new starts and the existing runs are returned with 200.",
        "operationId": "trigger_run_api_v1_admin_analytics_runs_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunTriggerOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Trigger Run",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_api_v1_auth_login_post",
